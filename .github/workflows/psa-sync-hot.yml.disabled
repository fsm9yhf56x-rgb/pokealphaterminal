name: PSA Sync HOT (daily)

on:
  schedule:
    - cron: '0 3 1 * *'  # 1er du mois 3h UTC (EN tier hot)
  workflow_dispatch:

permissions:
  contents: write

jobs:
  scrape-hot:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - name: Install dependencies
        run: npm ci
      - name: Install Chromium for Puppeteer
        run: npx puppeteer browsers install chrome
      - name: Run PSA scraper (hot tier)
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
        run: npm run psa:scrape:hot

      - name: Rebuild static JSON
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
        run: node scripts/rebuild-static-data.mjs

      - name: Auto-commit JSON updates
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add public/data/*.json
          git diff --staged --quiet || (git commit -m "chore(data): auto-rebuild after PSA sync $(date +%Y-%m-%d)" && git push)
